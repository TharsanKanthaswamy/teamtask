// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum AdminLevel {
  SUPER_ADMIN
}

enum TeamStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TeamRole {
  TEAM_LEAD
  TEAM_MEMBER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  CHANGES_REQUESTED
  COMPLETED
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_UPDATED
  CONTRIBUTION_SUBMITTED
  REVIEW_PENDING
  WORK_APPROVED
  CHANGES_REQUESTED
  DEADLINE_APPROACHING
  TASK_OVERDUE
  PROJECT_LEAD_CHANGED
  PROJECT_MEMBERSHIP_CHANGED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE_TEAM
  UPDATE_TEAM
  DEACTIVATE_TEAM
  ADD_MEMBER
  REMOVE_MEMBER
  CHANGE_ROLE
  ASSIGN_LEAD
  SUPER_ADMIN_ACCESS
  CREATE_PROJECT
  UPDATE_PROJECT
  ARCHIVE_PROJECT
  ASSIGN_PROJECT_LEAD
  ADD_PROJECT_MEMBER
  REMOVE_PROJECT_MEMBER
  CREATE_MILESTONE
  UPDATE_MILESTONE
  DELETE_MILESTONE
  CREATE_TASK
  UPDATE_TASK
  ASSIGN_TASK
  UNASSIGN_TASK
  SUBMIT_CONTRIBUTION
  APPROVE_CONTRIBUTION
  REJECT_CONTRIBUTION
  REQUEST_CHANGES
}

model User {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String     @unique
  passwordHash String     @map("password_hash")
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  platformAdmin PlatformAdmin?
  teamMembers   TeamMember[]
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@map("users")
}

model PlatformAdmin {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String     @unique @map("user_id") @db.Uuid
  adminLevel AdminLevel @map("admin_level")
  enabled    Boolean    @default(true)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("platform_admins")
}

model Team {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String     @unique
  description String?
  status      TeamStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(3)

  members          TeamMember[]
  auditLogs        AuditLog[]
  projects         Project[]
  projectMembers   ProjectMember[]
  milestones       Milestone[]
  tasks            Task[]
  taskAssignees    TaskAssignee[]
  contributionLogs ContributionLog[]
  taskReviews      TaskReview[]

  @@map("teams")
}

model TeamMember {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String     @map("team_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      TeamRole
  status    UserStatus @default(ACTIVE)
  joinedAt  DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  team           Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledProjects    Project[]       @relation("ProjectLead")
  projectMembers ProjectMember[]
  taskAssignees  TaskAssignee[]

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String      @map("actor_id") @db.Uuid
  teamId     String?     @map("team_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String      @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([teamId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String   @unique
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

model Project {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId        String          @map("team_id") @db.Uuid
  name          String
  slug          String
  description   String?
  objectives    String?
  projectLeadId String          @map("project_lead_id") @db.Uuid
  status        ProjectStatus   @default(PLANNING)
  priority      ProjectPriority @default(MEDIUM)
  startDate     DateTime?       @map("start_date") @db.Timestamptz(3)
  targetEndDate DateTime?       @map("target_end_date") @db.Timestamptz(3)
  actualEndDate DateTime?       @map("actual_end_date") @db.Timestamptz(3)
  createdBy     String          @map("created_by") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt    DateTime?       @map("archived_at") @db.Timestamptz(3)

  team        Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectLead TeamMember      @relation("ProjectLead", fields: [projectLeadId], references: [id], onDelete: Restrict)
  members     ProjectMember[]
  milestones  Milestone[]
  tasks       Task[]

  @@unique([teamId, slug])
  @@index([teamId])
  @@index([projectLeadId])
  @@index([status])
  @@index([createdAt])
  @@map("projects")
}

model ProjectMember {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId         String     @map("team_id") @db.Uuid
  projectId      String     @map("project_id") @db.Uuid
  teamMemberId   String     @map("team_member_id") @db.Uuid
  responsibility String?
  joinedAt       DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamMemberId])
  @@index([teamId])
  @@index([projectId])
  @@index([teamMemberId])
  @@map("project_members")
}

model Milestone {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String          @map("team_id") @db.Uuid
  projectId   String          @map("project_id") @db.Uuid
  title       String
  description String?
  startDate   DateTime?       @map("start_date") @db.Timestamptz(3)
  dueDate     DateTime?       @map("due_date") @db.Timestamptz(3)
  status      MilestoneStatus @default(NOT_STARTED)
  weight      Int?
  sequence    Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([teamId])
  @@index([projectId])
  @@index([sequence])
  @@map("milestones")
}

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String       @map("team_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  milestoneId String?      @map("milestone_id") @db.Uuid
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  weight      Int          @default(1)
  startDate   DateTime?    @map("start_date") @db.Timestamptz(3)
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(3)
  createdBy   String       @map("created_by") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignees TaskAssignee[]
  reviews   TaskReview[]

  @@index([teamId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@map("tasks")
}

model TaskAssignee {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId           String     @map("team_id") @db.Uuid
  taskId           String     @map("task_id") @db.Uuid
  teamMemberId     String     @map("team_member_id") @db.Uuid
  responsibility   String?
  allocatedWeight  Int        @default(100) @map("allocated_weight")
  reportedProgress Int        @default(0) @map("reported_progress")
  approvedProgress Int        @default(0) @map("approved_progress")
  status           UserStatus @default(ACTIVE)
  assignedAt       DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  team             Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  task             Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  teamMember       TeamMember        @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  contributionLogs ContributionLog[]
  reviews          TaskReview[]      @relation("RevieweeAssignee")

  @@unique([taskId, teamMemberId])
  @@index([teamId])
  @@index([taskId])
  @@index([teamMemberId])
  @@map("task_assignees")
}

model ContributionLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId          String   @map("team_id") @db.Uuid
  taskAssigneeId  String   @map("task_assignee_id") @db.Uuid
  submittedBy     String   @map("submitted_by") @db.Uuid
  progressPercent Int      @map("progress_percent")
  hoursSpent      Float?   @map("hours_spent")
  description     String
  evidenceUrl     String?  @map("evidence_url")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  taskAssignee TaskAssignee @relation(fields: [taskAssigneeId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([taskAssigneeId])
  @@index([createdAt])
  @@map("contribution_logs")
}

model TaskReview {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId         String       @map("team_id") @db.Uuid
  taskId         String       @map("task_id") @db.Uuid
  taskAssigneeId String       @map("task_assignee_id") @db.Uuid
  submittedBy    String       @map("submitted_by") @db.Uuid
  reviewerId     String?      @map("reviewer_id") @db.Uuid
  status         ReviewStatus @default(PENDING)
  feedback       String?
  submittedAt    DateTime     @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt     DateTime?    @map("reviewed_at") @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskAssignee TaskAssignee @relation("RevieweeAssignee", fields: [taskAssigneeId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([taskId])
  @@index([taskAssigneeId])
  @@index([status])
  @@index([submittedAt])
  @@map("task_reviews")
}

model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  message    String
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id") @db.Uuid
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

# Database
DATABASE_URL="postgresql://teamtrack:password@localhost:5432/teamtrack?schema=public"
DIRECT_URL="postgresql://teamtrack:password@localhost:5432/teamtrack?schema=public"

# Application
NODE_ENV="development"
APP_URL="http://localhost:3000"
API_URL="http://localhost:3001"
API_PORT=3001

# Authentication
SESSION_SECRET="change-this-to-a-secure-random-string-in-production"
SESSION_MAX_AGE=604800000

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="https://your-backend-api-url/api/v1/auth/google/callback"

# Email Service (SMTP for Password Reset OTP)
# Works with Gmail (App Password), Resend, SendGrid, Brevo, or any custom SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="TeamTrack <noreply@teamtrack.app>"

# Super Admin Bootstrap (used only for initial setup)
# BOOTSTRAP_ADMIN_EMAIL="admin@teamtrack.local"
# BOOTSTRAP_ADMIN_PASSWORD="use-a-strong-password"
# BOOTSTRAP_ADMIN_NAME="Super Administrator"
